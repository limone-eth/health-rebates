# Copy to .env. Never commit .env.
# Create a key at https://cloud.near.ai
NEARAI_CLOUD_API_KEY=
# Optional. Must be a NEAR-hosted model with TEE evidence. Default: Qwen/Qwen3.8-27B
NEARAI_MODEL=

# Optional: tracker connections on the hosted copy. Each device maker gives these when you create its app.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
